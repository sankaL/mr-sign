# Local Docker Compose
APP_PORT=3000
DB_PORT=5432

# Database container
POSTGRES_DB=mr_sign
POSTGRES_USER=mrsign
POSTGRES_PASSWORD=mrsign

# App container
DATABASE_URL=postgresql://mrsign:mrsign@db:5432/mr_sign
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-secure-secret

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Mr. Sign and Print <no-reply@mrsignandprint.net>"
ADMIN_NOTIFICATION_EMAIL=order@mrsignandprint.net

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
