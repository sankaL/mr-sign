{
  "name": "mr-sign",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "corepack pnpm --filter @mrsign/web dev",
    "build": "corepack pnpm --filter @mrsign/web build",
    "start": "corepack pnpm --filter @mrsign/web start",
    "lint": "corepack pnpm --filter @mrsign/web lint",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "format": "corepack pnpm --filter @mrsign/web format",
    "format:check": "corepack pnpm --recursive --if-present format:check",
    "test": "corepack pnpm --recursive --if-present test",
    "db:generate": "corepack pnpm --filter @mrsign/db generate",
    "db:migrate": "corepack pnpm --filter @mrsign/db migrate",
    "db:migrate:deploy": "corepack pnpm --filter @mrsign/db migrate:deploy",
    "db:seed": "corepack pnpm --filter @mrsign/db seed",
    "db:seed:requests": "corepack pnpm --filter @mrsign/db seed:requests",
    "db:create-admin": "corepack pnpm --filter @mrsign/db create-admin"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
