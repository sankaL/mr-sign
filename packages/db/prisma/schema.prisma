generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PricingType {
  EXACT_PRICE
  STARTING_FROM
  TIERED
  REQUEST_QUOTE
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum RequestType {
  QUOTE
  ORDER
  CONTACT
}

enum RequestStatus {
  NEW
  UNDER_REVIEW
  QUOTE_SENT
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  IN_PRODUCTION
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PreferredContactMethod {
  PHONE
  EMAIL
  EITHER
}

enum ArtworkStatus {
  WILL_EMAIL_FILES
  NEEDS_DESIGN_HELP
  HAS_ROUGH_IDEA
  NOT_APPLICABLE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
}

model ServiceCategory {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]

  @@map("service_categories")
}

model Service {
  id               String           @id @default(cuid())
  categoryId       String
  name             String
  slug             String
  shortDescription String
  description      String?
  imagePath        String?
  imageAlt         String?
  metaTitle        String?
  metaDescription  String?
  isActive         Boolean          @default(true) @ignore
  status           ServiceStatus    @default(DRAFT)
  isFeatured       Boolean          @default(false)
  displayOrder     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  pricing          Pricing?
  requestServices  RequestService[]

  @@unique([categoryId, slug])
  @@index([categoryId, displayOrder])
  @@index([status])
  @@map("services")
}

model Pricing {
  id                String      @id @default(cuid())
  serviceId         String      @unique
  type              PricingType @default(REQUEST_QUOTE)
  amountCents       Int?
  currency          String      @default("CAD")
  unitLabel         String?
  tieredDescription String?
  publicLabel       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  service           Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("pricing")
}

model CustomerRequest {
  id                     String                  @id @default(cuid())
  requestCode            String                  @unique
  type                   RequestType
  status                 RequestStatus           @default(NEW)
  firstName              String
  lastName               String
  email                  String
  phone                  String?
  companyName            String?
  preferredContactMethod PreferredContactMethod?
  reasonForContact       String?
  quantity               Int?
  sizeDetails            String?
  materialDetails        String?
  colorPreferences       String?
  artworkStatus          ArtworkStatus           @default(NOT_APPLICABLE)
  desiredCompletionDate  DateTime?
  projectDetails         String
  adminSummary           String?
  submittedAt            DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  services               RequestService[]
  notes                  RequestNote[]
  auditLogs              AuditLog[]

  @@index([type, status])
  @@index([submittedAt])
  @@map("customer_requests")
}

model RequestService {
  id        String          @id @default(cuid())
  requestId String
  serviceId String
  createdAt DateTime        @default(now())
  request   CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([requestId, serviceId])
  @@map("request_services")
}

model RequestNote {
  id        String          @id @default(cuid())
  requestId String
  authorId  String?
  body      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  request   CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("request_notes")
}

model AdminUser {
  id        String        @id @default(cuid())
  userId    String?       @unique
  email     String        @unique
  name      String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes     RequestNote[]
  auditLogs AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id        String           @id @default(cuid())
  adminId   String?
  requestId String?
  action    AuditAction
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime         @default(now())
  admin     AdminUser?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  request   CustomerRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RequestCodeCounter {
  requestType RequestType
  year        Int
  lastNumber  Int         @default(0)
  updatedAt   DateTime    @updatedAt

  @@id([requestType, year])
  @@map("request_code_counters")
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  adminUser     AdminUser?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}
